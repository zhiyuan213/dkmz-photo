/* 左侧使用清晰原生文字，右侧按素材原始比例完整展示插画。 */
.hero-wrap {
  position: relative;
  margin: -8rpx -24rpx 24rpx;
  padding: 22rpx 26rpx 16rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #eaf4ff, #f3f8ff);
}
.hero-main { position: relative; height: 154rpx; }
.hero-copy { position: relative; z-index: 1; padding-top: 20rpx; width: 448rpx; }
.hero-title { white-space: nowrap; font-size: 34rpx; line-height: 1.5; font-weight: 700; color: #18345c; }
.hero-sub { margin-top: 9rpx; font-size: 23rpx; line-height: 1.6; color: #617591; }
.hero-art { position: absolute; right: -8rpx; bottom: 0; width: 280rpx; height: 154rpx; overflow: hidden; }
.hero-banner { position: absolute; right: 0; bottom: 0; width: 700rpx; display: block; }
.hero-features { display: flex; gap: 8rpx; padding-top: 12rpx; border-top: 1rpx solid #d9e7f7; }
.hero-features text { flex: 1; text-align: center; font-size: 22rpx; line-height: 1.6; color: #476789; }
button.share-btn {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  width: 48rpx !important;
  min-width: 0 !important;
  max-width: 48rpx !important;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 12rpx;
  box-shadow: 0 2rpx 6rpx rgba(23, 78, 166, 0.08);
  box-sizing: border-box;
  overflow: hidden;
}
.share-btn::after { border: none; }
.share-icon { width: 26rpx; height: 26rpx; }
.share-pressed { opacity: 0.7; }

.exam-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(23, 78, 166, 0.06);
}

.exam-card.press {
  opacity: 0.75;
}

.exam-main {
  flex: 1;
  min-width: 0;
}

.exam-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2430;
  line-height: 1.5;
}

.exam-stage {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #66738a;
  line-height: 1.6;
}

.exam-meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  font-size: 22rpx;
  color: #2e7cf6;
  background: #e9f2fd;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.arrow {
  color: #c3cad4;
  font-size: 40rpx;
  margin-left: 12rpx;
}

.empty {
  text-align: center;
  color: #8a94a6;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.footer {
  margin-top: 40rpx;
  padding: 0 8rpx 20rpx;
}

.footer-meta {
  font-size: 22rpx;
  color: #8a94a6;
}

.footer-disclaimer {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #a8b0bd;
  line-height: 1.6;
}

.footer-lab {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #9aa7d8;
  text-align: center;
}

/* 页脚：我的订单与权益入口 */
.footer-orders {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  color: #0d60f8;
}

.footer-orders-arrow {
  margin-left: 8rpx;
  color: #a9c3f0;
}

/* 页脚合规入口：关于 / 隐私政策 / 用户协议 */
.footer-links {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.footer-link {
  font-size: 24rpx;
  color: #5b8df0;
  padding: 6rpx 0;
}

.footer-link-sep {
  font-size: 22rpx;
  color: #c6ccd8;
  margin: 0 14rpx;
}
