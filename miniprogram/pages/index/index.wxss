/* 使用原生文字和独立插画，让横幅在手机上保持清晰可读。 */
.hero-wrap {
  position: relative;
  margin: -8rpx -24rpx 24rpx;
  padding: 28rpx 28rpx 22rpx;
  background: linear-gradient(135deg, #e9f3ff, #f5f9ff);
}
.hero-main { position: relative; min-height: 232rpx; }
.hero-copy { position: relative; z-index: 1; padding-top: 10rpx; width: 430rpx; }
.hero-title { font-size: 42rpx; line-height: 1.4; font-weight: 700; color: #182d50; }
.hero-sub { margin-top: 14rpx; font-size: 25rpx; line-height: 1.6; color: #586e8e; }
.hero-art { position: absolute; right: 0; bottom: 0; width: 258rpx; height: 204rpx; overflow: hidden; }
.hero-banner { position: absolute; right: -4rpx; bottom: 0; width: 930rpx; display: block; }
.hero-features { display: flex; justify-content: space-between; gap: 12rpx; padding-top: 14rpx; border-top: 1rpx solid #dce8f7; }
.hero-features text { flex: 1; text-align: center; font-size: 24rpx; line-height: 1.6; color: #42648c; }
button.share-btn {
  position: absolute;
  top: 14rpx;
  right: 22rpx;
  width: 60rpx !important;
  min-width: 0 !important;
  max-width: 60rpx !important;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 14rpx;
  box-shadow: 0 2rpx 6rpx rgba(23, 78, 166, 0.08);
  box-sizing: border-box;
  overflow: hidden;
}
.share-btn::after { border: none; }
.share-icon { width: 32rpx; height: 32rpx; }
.share-pressed { opacity: 0.7; }

.exam-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(23, 78, 166, 0.06);
}

.exam-card.press {
  opacity: 0.75;
}

.exam-main {
  flex: 1;
  min-width: 0;
}

.exam-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2430;
  line-height: 1.5;
}

.exam-stage {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #66738a;
  line-height: 1.6;
}

.exam-meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  font-size: 22rpx;
  color: #2e7cf6;
  background: #e9f2fd;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.arrow {
  color: #c3cad4;
  font-size: 40rpx;
  margin-left: 12rpx;
}

.empty {
  text-align: center;
  color: #8a94a6;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.footer {
  margin-top: 40rpx;
  padding: 0 8rpx 20rpx;
}

.footer-meta {
  font-size: 22rpx;
  color: #8a94a6;
}

.footer-disclaimer {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #a8b0bd;
  line-height: 1.6;
}

.footer-lab {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #9aa7d8;
  text-align: center;
}

/* 页脚：我的订单与权益入口 */
.footer-orders {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  color: #0d60f8;
}

.footer-orders-arrow {
  margin-left: 8rpx;
  color: #a9c3f0;
}

/* 页脚合规入口：关于 / 隐私政策 / 用户协议 */
.footer-links {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.footer-link {
  font-size: 24rpx;
  color: #5b8df0;
  padding: 6rpx 0;
}

.footer-link-sep {
  font-size: 22rpx;
  color: #c6ccd8;
  margin: 0 14rpx;
}
