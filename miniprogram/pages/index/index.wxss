/* 首页：横幅 + 底色选择 + 尺寸选择（两列）+ 主操作
 * 字号 / 按钮 / 卡片均来自 app.wxss 全局规范，这里只写页面特有的布局 */

/* ---------- 顶部横幅 ---------- */

.hero-wrap {
  position: relative;
  margin: 0 0 10rpx;
  padding: 14rpx 18rpx 10rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #eaf4ff, #f3f8ff);
  border-radius: 20rpx;
}

.hero-main {
  position: relative;
  height: 108rpx;
}

.hero-copy {
  position: relative;
  z-index: 1;
  padding-top: 12rpx;
  width: 430rpx;
}

.hero-title {
  white-space: nowrap;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #18345c;
}

.hero-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #617591;
}

.hero-art {
  position: absolute;
  /* 给右上角收藏、分享两个按钮留出完整空间。 */
  right: 134rpx;
  bottom: 0;
  width: 208rpx;
  height: 108rpx;
  overflow: hidden;
}

/* 插画裁剪边缘做柔和过渡，避免右侧出现明显的竖直断层。 */
.hero-art::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  width: 34rpx;
  pointer-events: none;
  background: linear-gradient(90deg, rgba(243, 248, 255, 0), #f3f8ff 88%);
}

.hero-banner {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 520rpx;
  display: block;
}

.hero-actions {
  position: absolute;
  top: 14rpx;
  right: 16rpx;
  z-index: 2;
  display: flex;
  gap: 10rpx;
}

.hero-action-btn {
  width: 68rpx !important;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
  background: transparent;
  border: none;
  border-radius: 16rpx;
  box-shadow: none;
}

.hero-action-btn::after {
  border: none;
}

.hero-action-icon {
  width: 68rpx;
  height: 68rpx;
}

/* ---------- 底色选择 ---------- */

.color-row {
  position: relative;
  display: flex;
  gap: 12rpx;
}

/* 滑动高亮块样式在 app.wxss 的 .slide-hl（全局唯一来源） */

.color-item {
  flex: 1;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 9rpx 0 8rpx;
  /* 与尺寸卡一致：每张卡自己的浅灰描边 */
  border: 2rpx solid var(--c-line);
  border-radius: 16rpx;
  transition: transform 0.2s ease;
}

.color-item.press {
  transform: scale(0.94);
}

/* 选中态由下层滑动高亮块描边；隐藏卡片自身灰边，避免盖住蓝色选中框。 */
.color-item.on {
  border-color: transparent;
}

.color-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1rpx solid #e2e7ef;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 选中的色点放大一档并带阴影，像被「按亮」 */
.color-item.on .color-dot {
  transform: scale(1.12);
  box-shadow: 0 4rpx 10rpx rgba(23, 78, 166, 0.18);
}

.color-name {
  margin-top: 5rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--c-text-2);
  transition: color 0.2s ease;
}

.color-item.on .color-name {
  color: var(--c-blue);
  font-weight: 600;
}

/* ---------- 尺寸选择（两列网格） ---------- */

.size-grid {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

/* 滑动高亮块样式在 app.wxss 的 .slide-hl（全局唯一来源） */

.size-card {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: calc((100% - 8rpx) / 2);
  /* 所有卡都带场景标注后，内边距收紧补偿外框高度 */
  padding: 7rpx 10rpx;
  border: 2rpx solid var(--c-line);
  border-radius: 16rpx;
}

/* 选中态由滑块表达，卡片自身边框透明（保持盒尺寸不变，避免文字跳动） */
.size-card.on {
  border-color: transparent;
}

.size-card.press {
  transform: scale(0.97);
  opacity: 0.85;
}

.size-usage {
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--c-blue);
}

/* ---------- 动效关键帧 ---------- */

@keyframes check-pop {
  0% { transform: scale(0); opacity: 0; }
  70% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(1); }
}

.size-name {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--c-text);
  padding-right: 40rpx;
}

.size-usage {
  margin-top: 2rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--c-blue);
}

.size-summary {
  margin-top: 2rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--c-text-3);
}

.size-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--c-blue);
  color: #fff;
  font-size: 22rpx;
  /* 勾标从小弹到大，带一点过冲 */
  animation: check-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ---------- 主操作 ---------- */

.start-bar {
  margin-top: 12rpx;
}

/* 按压态统一在 app.wxss 的 .btn-pressed 定义 */

/* ---------- 页脚 ---------- */

.footer {
  margin-top: 12rpx;
  padding: 0 6rpx;
}

.footer-meta {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--c-text-3);
  text-align: center;
}

.footer-disclaimer {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #a8b0bd;
  text-align: center;
}

.footer-orders {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--c-blue);
}

.footer-orders-arrow {
  margin-left: 8rpx;
  color: #a9c3f0;
}

.footer-links {
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.footer-link {
  font-size: 24rpx;
  padding: 4rpx 0;
  color: #5b8df0;
}

.footer-link-sep {
  font-size: 22rpx;
  color: #c6ccd8;
  margin: 0 12rpx;
}

.footer-lab {
  margin-top: 6rpx;
  font-size: 22rpx;
  text-align: center;
  color: #9aa7d8;
}
