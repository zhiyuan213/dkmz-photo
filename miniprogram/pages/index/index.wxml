<view class="page">

  <view class="hero-wrap">
    <view class="hero-main">
      <view class="hero-copy">
        <view class="hero-title">证件照，3分钟搞定</view>
        <view class="hero-sub">选底色 · 选尺寸 · 自动裁剪换底</view>
      </view>
      <view class="hero-art" wx:if="{{bannerOk}}">
        <image class="hero-banner" src="/assets/banner-hero.jpg" mode="widthFix" binderror="onBannerError" />
      </view>
    </view>
    <button class="share-btn" open-type="share" aria-label="分享小程序给朋友">
      <image class="share-icon" src="/assets/btn-friend.png" mode="aspectFit" />
    </button>
  </view>

  <!-- 底色：所有底色平铺，不再按场景区分 -->
  <view class="card">
    <view class="card-title">选择底色</view>
    <view class="color-row">
      <!-- 滑动高亮块：随选中项平滑移动（位置由 JS 实测），样式全局唯一 -->
      <view class="slide-hl" style="{{colorSlider}}"></view>
      <view
        class="color-item {{item.id === colorId ? 'on' : ''}}"
        wx:for="{{colors}}"
        wx:key="id"
        id="color-{{item.id}}"
        data-id="{{item.id}}"
        bindtap="onPickColor"
        hover-class="press"
      >
        <view class="color-dot" style="background:{{item.hex}}"></view>
        <view class="color-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- 尺寸：所有尺寸两列平铺，副标题是该尺寸的适用场景标注 -->
  <view class="card">
    <view class="card-title">选择尺寸</view>
    <view class="size-grid">
      <!-- 滑动高亮块：位置由 JS 实测卡片得到，横竖都能滑（样式全局唯一） -->
      <view class="slide-hl" style="{{sizeSlider}}"></view>
      <view
        class="size-card {{item.id === sizeId ? 'on' : ''}}"
        wx:for="{{sizes}}"
        wx:key="id"
        id="size-{{item.id}}"
        data-id="{{item.id}}"
        bindtap="onPickSize"
        hover-class="press"
      >
        <view class="size-check" wx:if="{{item.id === sizeId}}">✓</view>
        <view class="size-name">{{item.name}}</view>
        <view class="size-summary">{{item.summary}}</view>
        <!-- 适用场景：所有卡都显示（蓝色标注行） -->
        <view class="size-usage">{{item.usage}}</view>
      </view>
    </view>

    <view class="empty" wx:if="{{!sizes.length}}">规格库加载中，下拉可刷新</view>
  </view>

  <view class="start-bar">
    <button class="btn lg" bindtap="onStart" hover-class="btn-pressed">开始制作</button>
  </view>

  <view class="footer">
    <view class="footer-meta">{{specSource}} v{{meta.version}} · 更新于 {{meta.updatedAt}}</view>
    <view class="footer-disclaimer">{{meta.disclaimer}}</view>
    <view class="footer-orders" wx:if="{{!configLoading && !reviewMode}}" bindtap="onOpenOrders">
      <text>我的订单与权益</text>
      <text class="footer-orders-arrow">›</text>
    </view>
    <view class="footer-links">
      <text class="footer-link" bindtap="onOpenAbout">关于与开源声明</text>
      <text class="footer-link-sep">·</text>
      <text class="footer-link" bindtap="onOpenPrivacy">用户隐私保护政策</text>
      <text class="footer-link-sep">·</text>
      <text class="footer-link" bindtap="onOpenAgreement">用户协议</text>
    </view>
    <view class="footer-lab" wx:if="{{!configLoading && !reviewMode}}" bindtap="onOpenLab">端上引擎自检（开发用）›</view>
  </view>

</view>
