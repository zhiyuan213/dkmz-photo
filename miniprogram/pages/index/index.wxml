<view class="page">

  <!-- 头图横幅（设计稿裁切，含主标题/流程/卖点；全出血铺满屏幕宽） -->
  <image
    wx:if="{{bannerOk}}"
    class="hero-banner"
    src="/assets/banner-hero.jpg"
    mode="widthFix"
    binderror="onBannerError"
  />
  <!-- 横幅加载失败时回退文字版头，避免开天窗 -->
  <view class="hero" wx:else>
    <view class="hero-title">考试报名照，3 分钟搞定</view>
    <view class="hero-sub">选考试 → 自动裁剪 → 一键换底 → 按规格导出</view>
  </view>

  <view class="list">
    <view
      class="exam-card"
      wx:for="{{exams}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onPickExam"
      hover-class="press"
    >
      <view class="exam-main">
        <view class="exam-name">{{item.name}}</view>
        <view class="exam-stage">{{item.stage}}</view>
        <view class="exam-meta">
          <text class="chip">{{item.bgNames}}</text>
          <text class="chip">{{item.sizeSummary}}</text>
        </view>
      </view>
      <view class="arrow">›</view>
    </view>

    <view class="empty" wx:if="{{!exams.length}}">规格库加载中，下拉可刷新</view>
  </view>

  <view class="footer">
    <view class="footer-meta">{{specSource}} v{{meta.version}} · 更新于 {{meta.updatedAt}}</view>
    <view class="footer-disclaimer">{{meta.disclaimer}}</view>
    <view class="footer-orders" wx:if="{{!reviewMode}}" bindtap="onOpenOrders">
      <text>我的订单与权益</text>
      <text class="footer-orders-arrow">›</text>
    </view>
    <view class="footer-links">
      <text class="footer-link" bindtap="onOpenAbout">关于与开源声明</text>
      <text class="footer-link-sep">·</text>
      <text class="footer-link" bindtap="onOpenPrivacy">用户隐私保护政策</text>
      <text class="footer-link-sep">·</text>
      <text class="footer-link" bindtap="onOpenAgreement">用户协议</text>
    </view>
    <view class="footer-lab" wx:if="{{!reviewMode}}" bindtap="onOpenLab">端上引擎自检（开发用）›</view>
  </view>

</view>
