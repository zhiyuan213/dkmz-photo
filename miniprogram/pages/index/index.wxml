<view class="page">

  <view class="hero-wrap">
    <view class="hero-main">
      <view class="hero-copy">
        <view class="hero-title">考试报名照，3分钟搞定</view>
        <view class="hero-sub">选规格 · 自动裁剪 · 一键换底</view>
      </view>
      <view class="hero-art" wx:if="{{bannerOk}}">
        <image class="hero-banner" src="/assets/banner-hero.jpg" mode="widthFix" binderror="onBannerError" />
      </view>
    </view>
    <view class="hero-features">
      <text>官方规格</text><text>智能裁剪</text><text>多种底色</text><text>高清导出</text>
    </view>
    <button class="share-btn" size="mini" open-type="share" aria-label="分享小程序给朋友" hover-class="share-pressed">
      <image class="share-icon" src="/assets/share-plane.png" mode="aspectFit" />
    </button>
  </view>

  <view class="list">
    <view
      class="exam-card"
      wx:for="{{exams}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onPickExam"
      hover-class="press"
    >
      <view class="exam-main">
        <view class="exam-name">{{item.name}}</view>
        <view class="exam-stage">{{item.stage}}</view>
        <view class="exam-meta">
          <text class="chip">{{item.bgNames}}</text>
          <text class="chip">{{item.sizeSummary}}</text>
        </view>
      </view>
      <view class="arrow">›</view>
    </view>

    <view class="empty" wx:if="{{!exams.length}}">规格库加载中，下拉可刷新</view>
  </view>

  <view class="footer">
    <view class="footer-meta">{{specSource}} v{{meta.version}} · 更新于 {{meta.updatedAt}}</view>
    <view class="footer-disclaimer">{{meta.disclaimer}}</view>
    <view class="footer-orders" wx:if="{{!configLoading && !reviewMode}}" bindtap="onOpenOrders">
      <text>我的订单与权益</text>
      <text class="footer-orders-arrow">›</text>
    </view>
    <view class="footer-links">
      <text class="footer-link" bindtap="onOpenAbout">关于与开源声明</text>
      <text class="footer-link-sep">·</text>
      <text class="footer-link" bindtap="onOpenPrivacy">用户隐私保护政策</text>
      <text class="footer-link-sep">·</text>
      <text class="footer-link" bindtap="onOpenAgreement">用户协议</text>
    </view>
    <view class="footer-lab" wx:if="{{!configLoading && !reviewMode}}" bindtap="onOpenLab">端上引擎自检（开发用）›</view>
  </view>

</view>
