/* 关于与开源声明：继承 doc.wxss 的正文规范，仅补充顶部品牌区 */

.about-hero {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

/* 品牌徽标：与主色调一致的主蓝渐变（原红色改为蓝调） */
.about-badge {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #3d8bff, #0d60f8);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(13, 96, 248, 0.24);
}

.about-name {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  color: var(--c-text);
}

.about-ver {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--c-text-3);
}
