.preview-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 预览：宽度固定、高度随图片比例自适应（widthFix）。
   不能写死 height+aspectFit：不同规格比例不同（0.688/0.75…），留空处会露出背景色，看起来像照片带了边框 */
.preview {
  width: 420rpx;
  background: #edf3fc;
  border-radius: 16rpx;
}

.preview-cap {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #5a6474;
}

.watermark-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a8b0bd;
}

.check {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.check-icon {
  width: 40rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.check-icon.ok {
  color: #17a34a;
}

.check-icon.warn {
  color: #d97706;
}

.check-icon.bad {
  color: #d9432f;
}

.check-body {
  flex: 1;
}

.check-k {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2430;
}

.check-v {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8a94a6;
  line-height: 1.6;
}

.note {
  font-size: 26rpx;
  color: #5a6474;
  line-height: 1.8;
}

.btn.big {
  font-size: 32rpx;
  padding: 10rpx 0;
}
