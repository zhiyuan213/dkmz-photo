/* 结果页：预览 + 规格检查（单行紧凑）+ 本次消耗 + 处理明细（折叠）+ 底部固定栏
 * 目标：主信息与「保存到相册」都在第一屏内 */

.page {
  padding-bottom: calc(116rpx + env(safe-area-inset-bottom));
}

/* ---------- 预览 ---------- */

.preview-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
}

/* 宽度收窄一档，保证预览 + 检查 + 底部栏同屏；比例随规格自适应 */
.preview {
  width: 340rpx;
  background: var(--c-blue-soft);
  border-radius: 14rpx;
}

.preview-cap {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--c-text-2);
}

/* ---------- 规格检查（一行一条：✓ 项目 …… 值） ---------- */

.check {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
}

.check-icon {
  flex-shrink: 0;
  width: 34rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}

.check-k {
  flex-shrink: 0;
  margin-right: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--c-text);
}

.check-v {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--c-text-2);
  word-break: break-word;
}

/* ---------- 页脚 ---------- */

.page-disclaimer {
  padding: 0 6rpx;
  margin-top: 4rpx;
}
