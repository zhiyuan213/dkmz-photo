<view class="page" wx:if="{{size}}">

  <!-- 尺寸只用于构图比例；成片保持高清，不按平台像素/体积二次压缩。 -->
  <view class="card">
    <view class="card-title">{{size.name}}</view>
    <view class="kv">
      <text>导出方式</text>
      <text class="v spec-value">按比例高清保存</text>
    </view>
    <view class="kv" wx:if="{{size.mm}}">
      <text>构图参考</text>
      <text class="v spec-value">{{size.mm[0]}} × {{size.mm[1]}} mm</text>
    </view>
    <view class="kv">
      <text>构图用途</text>
      <text class="v">{{sizeUsage}}</text>
    </view>
    <view class="hint">报名上传前，请核对报考平台的像素和体积要求。</view>
  </view>

  <!-- 底色 -->
  <view class="card">
    <view class="card-title">底色</view>
    <view class="bg-row">
      <!-- 滑动高亮块：与首页底色选择一致（位置由 JS 实测，样式全局唯一） -->
      <view class="slide-hl" style="{{bgSlider}}"></view>
      <view
        class="bg-item {{bgIndex === index ? 'on' : ''}}"
        wx:for="{{bgOptions}}"
        wx:key="id"
        id="bg-{{item.id}}"
        bindtap="onBgChange"
        data-index="{{index}}"
        hover-class="press"
      >
        <view class="bg-swatch" style="background: {{item.hex}}"></view>
        <view class="bg-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- 处理方式：云端人像分割 + 换底，端上不再出片 -->
  <view class="card">
    <view class="card-title">处理方式</view>
    <view class="kv">
      <text>云端精修</text>
      <text class="{{cloudAvailable ? 'ok' : 'bad'}}">{{cloudAvailable ? '已连接' : '未连接'}}</text>
    </view>
    <view class="hint" wx:if="{{!cloudAvailable}}">云端暂不可用：请检查网络后重试。</view>
    <view class="hint" wx:else>照片将上传腾讯云做人像分割，并按所选底色合成后回传，仅用于生成结果。</view>
  </view>

  <!-- 拍摄要求：默认折叠，需要时展开（避免把主操作挤出首屏） -->
  <view class="card">
    <view class="card-title-row" bindtap="onToggleNotes">
      <view class="card-title">拍摄要求</view>
      <view class="fold">{{showNotes ? '收起 ⌃' : '展开 ⌄'}}</view>
    </view>
    <view class="hint" wx:if="{{!showNotes}}">半身照、正面、露双耳额头；点「展开」看完整要求。</view>
    <view class="soft-block" wx:if="{{showNotes}}">
      <view class="note" wx:for="{{shootNotes}}" wx:key="*this">· {{item}}</view>
      <view class="note">· 建议离镜头 0.5~1 米：人脸太近会导致裁剪过满、头顶留白不足。</view>
    </view>
  </view>

  <!-- 主操作紧跟拍摄要求，首屏即可看到和点击 -->
  <view class="make-action">
    <button class="btn primary" bindtap="onPickPhoto" disabled="{{busy}}" hover-class="btn-pressed">
      {{busy ? '制作中…' : srcPath ? '重新选照片' : '拍照 / 从相册选照片'}}
    </button>
  </view>

  <!-- 制作进度（仅在制作中展示） -->
  <view class="card" wx:if="{{busy}}">
    <view class="card-title">制作中…</view>
    <view class="step" wx:for="{{steps}}" wx:key="key">
      <text class="dot {{item.state}}"></text>
      <text class="step-label {{item.state}}">{{item.label}}</text>
    </view>
  </view>

  <!-- 内嵌相机层：默认前置摄像头，可翻转 -->
  <view class="camera-layer" wx:if="{{cameraVisible}}">
    <camera
      class="camera"
      device-position="{{devicePosition}}"
      flash="off"
      frame-size="medium"
      binderror="onCameraError"
    >
      <cover-view class="cam-guide" style="{{camFrameStyle}}"></cover-view>
      <cover-view class="cam-guide-tip" style="{{camFrameStyle}}">人脸贴入框内 · 头顶留一指宽</cover-view>
      <cover-view class="cam-tip">正面半身入画 · 光线均匀 · 距镜头 0.5~1 米</cover-view>
      <cover-view class="cam-actions">
        <cover-view class="cam-side" bindtap="onCameraCancel">取消</cover-view>
        <cover-view class="cam-shutter {{snapping ? 'busy' : ''}}" bindtap="onCameraSnap"></cover-view>
        <cover-view class="cam-side" bindtap="onCameraFlip">翻转</cover-view>
      </cover-view>
    </camera>
  </view>

</view>
