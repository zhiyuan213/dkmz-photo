.bg-row {
  display: flex;
  gap: 28rpx;
}

.bg-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.bg-item.active {
  border-color: #0d60f8;
  background: #edf4fe;
}

.bg-swatch {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 1rpx solid #e3e8ef;
}

.bg-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5a6474;
}

.btn.big {
  font-size: 32rpx;
  padding: 10rpx 0;
}

.steps {
  margin-top: 28rpx;
}

.step {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d5dbe3;
  margin-right: 16rpx;
}

.dot.doing {
  background: #0d60f8;
  animation: blink 1s infinite;
}

.dot.done {
  background: #17a34a;
}

@keyframes blink {
  50% {
    opacity: 0.3;
  }
}

.step-label {
  font-size: 26rpx;
  color: #8a94a6;
}

.step-label.doing {
  color: #0d60f8;
  font-weight: 600;
}

.step-label.done {
  color: #17a34a;
}

.note {
  font-size: 26rpx;
  color: #5a6474;
  line-height: 1.8;
}

/* ---------- 内嵌相机层 ---------- */

.camera-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: #000;
}

.camera {
  width: 100%;
  height: 100%;
}

.cam-tip {
  position: absolute;
  top: 100rpx;
  left: 40rpx;
  right: 40rpx;
  text-align: center;
  color: #ffffff;
  font-size: 26rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.6);
}

/* 取景引导框：透明轮廓，比例随考试规格（位置尺寸由 camFrameStyle 内联控制） */
.cam-guide {
  position: absolute;
  border: 3rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 16rpx;
}

/* 框内顶部提示（复用引导框的定位，向下偏移进入框内） */
.cam-guide-tip {
  position: absolute;
  text-align: center;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  padding-top: 18rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.6);
}

.cam-actions {
  position: absolute;
  bottom: 90rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.cam-side {
  color: #ffffff;
  font-size: 30rpx;
  padding: 20rpx 30rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.6);
}

.cam-shutter {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 10rpx solid rgba(255, 255, 255, 0.35);
}

.cam-shutter.busy {
  opacity: 0.4;
}

/* 云端精修：单开关行 */
.cloud-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cloud-switch-info {
  flex: 1;
  padding-right: 24rpx;
}

.cloud-switch-info .card-title {
  margin-bottom: 6rpx;
}

.cloud-switch-row switch {
  transform: scale(0.9);
}
