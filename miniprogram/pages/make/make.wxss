/* 制作页：底色选择 + 处理方式 + 拍摄要求 + 就近主操作
 * 字号/按钮/卡片均来自 app.wxss 全局规范 */

.page {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.make-action {
  margin: 4rpx 0 12rpx;
}

.make-action .btn {
  margin: 0;
}

/* 规格参数保持短值右对齐；来源说明独占一行，避免括号被挤到下一行。 */
.spec-value {
  font-weight: 600;
  color: var(--c-text);
  font-variant-numeric: tabular-nums;
}

.spec-note {
  margin: -2rpx 0 4rpx 156rpx;
  text-align: right;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--c-text-3);
}

/* ---------- 底色选择 ---------- */

.bg-row {
  position: relative;
  display: flex;
  gap: 12rpx;
}

/* 滑动高亮块样式在 app.wxss 的 .slide-hl（全局唯一来源） */

.bg-item {
  flex: 1;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 9rpx 0 8rpx;
  border: 2rpx solid var(--c-line);
  border-radius: 16rpx;
  transition: transform 0.2s ease;
}

.bg-item.press {
  transform: scale(0.94);
}

/* 选中态由滑块表达，卡片自身边框透明（盒尺寸不变） */
.bg-item.on {
  border-color: transparent;
}

.bg-swatch {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1rpx solid #e3e8ef;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 选中的色点放大一档并带阴影（与首页一致） */
.bg-item.on .bg-swatch {
  transform: scale(1.12);
  box-shadow: 0 4rpx 10rpx rgba(23, 78, 166, 0.18);
}

.bg-name {
  margin-top: 5rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--c-text-2);
  transition: color 0.2s ease;
}

.bg-item.on .bg-name {
  color: var(--c-blue);
  font-weight: 600;
}

/* ---------- 制作进度 ---------- */

.step {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d5dbe3;
  margin-right: 16rpx;
}

.dot.doing {
  background: var(--c-blue);
  animation: blink 1s infinite;
}

.dot.done {
  background: var(--c-ok);
}

@keyframes blink {
  50% {
    opacity: 0.3;
  }
}

.step-label {
  font-size: 26rpx;
  color: var(--c-text-3);
}

.step-label.doing {
  color: var(--c-blue);
  font-weight: 600;
}

.step-label.done {
  color: var(--c-ok);
}

/* ---------- 内嵌相机层 ---------- */

.camera-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: #000;
}

.camera {
  width: 100%;
  height: 100%;
}

.cam-tip {
  position: absolute;
  top: 100rpx;
  left: 40rpx;
  right: 40rpx;
  text-align: center;
  color: #ffffff;
  font-size: 26rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.6);
}

/* 取景引导框：透明轮廓，比例随所选尺寸（位置尺寸由 camFrameStyle 内联控制） */
.cam-guide {
  position: absolute;
  border: 3rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 16rpx;
}

.cam-guide-tip {
  position: absolute;
  text-align: center;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  padding-top: 18rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.6);
}

.cam-actions {
  position: absolute;
  bottom: 90rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.cam-side {
  color: #ffffff;
  font-size: 30rpx;
  padding: 20rpx 30rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.6);
}

.cam-shutter {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 10rpx solid rgba(255, 255, 255, 0.35);
}

.cam-shutter.busy {
  opacity: 0.4;
}
