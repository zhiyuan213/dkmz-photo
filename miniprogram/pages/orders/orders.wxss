.page {
  padding: 24rpx 24rpx 60rpx;
}

/* ---------- 权益概览 ---------- */
.ent-card {
  background: linear-gradient(135deg, #4a90e2, #3573d6);
  color: #fff;
}

.ent-row {
  display: flex;
  justify-content: space-between;
}

.ent-item {
  flex: 1;
  text-align: center;
}

.ent-num {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
}

.ent-label {
  font-size: 22rpx;
  opacity: 0.86;
  margin-top: 4rpx;
}

.ent-vip {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
  font-size: 22rpx;
  opacity: 0.92;
}

/* ---------- 订单卡 ---------- */
.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-name {
  font-size: 30rpx;
  font-weight: 600;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
}

.order-status.pending {
  color: #b26a00;
  background: #fff5e0;
}

.order-status.done {
  color: #1f8a4c;
  background: #e8f8ef;
}

.order-status.refunded {
  color: #8a94a6;
  background: #f0f2f6;
}

.order-benefit {
  margin: 12rpx 0 16rpx;
  font-size: 26rpx;
  color: #4a90e2;
}

.order-line {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 25rpx;
}

.order-key {
  color: #7c8798;
}

.order-val {
  color: #1f2430;
}

.mono {
  font-family: Menlo, Consolas, monospace;
  font-size: 23rpx;
}

.copy {
  margin-left: 12rpx;
  color: #4a90e2;
}

/* ---------- 空态 ---------- */
.empty {
  text-align: center;
  padding: 70rpx 24rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #4a5568;
  font-weight: 600;
}

.empty-desc {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #8892a4;
  line-height: 1.6;
}

.foot-note {
  margin: 8rpx 4rpx 24rpx;
  font-size: 23rpx;
  color: #98a2b3;
  line-height: 1.6;
}

.back {
  margin-top: 16rpx;
}

.btn {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.btn.ghost {
  background: #fff;
  color: #4a5568;
  border: 1rpx solid #e3e8ef;
}

.btn::after {
  border: none;
}
