/* 订单页：权益概览（蓝色渐变卡）+ 订单列表 + 底部操作
 * 字号/按钮/卡片均来自 app.wxss 全局规范 */

/* ---------- 权益概览 ---------- */

.ent-card {
  background: linear-gradient(135deg, #3d8bff, #0d60f8);
  color: #fff;
  padding: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(13, 96, 248, 0.18);
}

.ent-row {
  display: flex;
  justify-content: space-between;
}

.ent-item {
  flex: 1;
  text-align: center;
}

.ent-num {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.ent-label {
  font-size: 22rpx;
  line-height: 1.5;
  opacity: 0.86;
  margin-top: 4rpx;
}

.ent-vip {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
  font-size: 22rpx;
  line-height: 1.6;
  opacity: 0.92;
}

/* ---------- 订单卡 ---------- */

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--c-text);
}

.order-status {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  line-height: 1.4;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.order-status.pending {
  color: #b26a00;
  background: #fff5e0;
}

.order-status.done {
  color: #1f8a4c;
  background: #e8f8ef;
}

.order-status.refunded {
  color: var(--c-text-3);
  background: #f0f2f6;
}

.order-benefit {
  margin: 6rpx 0 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--c-blue);
}

.order-line {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 4rpx 0;
  font-size: 26rpx;
}

.order-key {
  flex-shrink: 0;
  margin-right: 20rpx;
  color: var(--c-text-2);
}

.order-val {
  flex: 1;
  text-align: right;
  color: var(--c-text);
  word-break: break-all;
}

.copy {
  margin-left: 12rpx;
  color: var(--c-blue);
}

/* ---------- 页脚与操作 ---------- */

.foot-note {
  margin: 0 6rpx 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--c-text-2);
}

/* 两个操作并排一行（沿用 .btn 默认 88rpx 规格） */
.order-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 12rpx;
}

.order-actions .btn {
  flex: 1;
  margin: 0;
}
