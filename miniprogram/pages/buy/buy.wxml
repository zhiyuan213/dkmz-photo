<view class="page">

  <!-- 备案模式：只显示占位，不出现任何商品/价格/会员信息 -->
  <block wx:if="{{reviewMode}}">
    <view class="card empty">
      <view class="empty-title">功能调整中</view>
      <view class="empty-desc">该功能正在升级维护，请稍后再来。</view>
    </view>
    <button class="btn ghost back" bindtap="onGoHome">返回首页</button>
  </block>

  <block wx:else>

  <!-- 权益概览 -->
  <view class="card ent-card" wx:if="{{entitlement}}">
    <view class="ent-line">
      <text wx:if="{{entitlement.vipActive}}" class="ent-vip">会员生效中 · 至 {{entitlement.vipExpireAt}}</text>
      <text wx:else class="ent-left">剩余可导出 <text class="ent-num">{{entitlement.remaining}}</text> 张</text>
    </view>
  </view>

  <!-- 未配置云端时给出明确说明 -->
  <view class="card empty" wx:if="{{!cloudEnabled}}">
    <view class="empty-title">购买服务未开通</view>
    <view class="empty-desc">当前为纯本地模式，购买功能需连接云托管后使用。</view>
  </view>

  <view class="card empty" wx:elif="{{loading}}">
    <view class="empty-title">加载中…</view>
  </view>

  <view class="card empty" wx:elif="{{error}}">
    <view class="empty-title">{{error}}</view>
    <view class="empty-desc">下拉可重试</view>
  </view>

  <!-- 商品列表 -->
  <view class="card processing-rules" wx:if="{{!configLoading}}">
    <view class="tip-title">云端制作与保存规则</view>
    <view class="tip-line">会员有效期内不限保存次数；云端制作受以下频率限制，普通用户与会员均适用。</view>
    <block wx:if="{{processingLimits && processingLimits.enabled}}">
      <view class="rule-row" wx:if="{{processingLimits.perMinute > 0}}">每分钟最多 <text class="rule-number">{{processingLimits.perMinute}}</text> 次云端制作</view>
      <view class="rule-row" wx:if="{{processingLimits.per24Hours > 0}}">连续 24 小时最多 <text class="rule-number">{{processingLimits.per24Hours}}</text> 次云端制作</view>
      <view class="tip-line">按请求时间滚动统计，不在午夜统一重置；达到上限后，待较早请求满 24 小时再制作。</view>
    </block>
    <view class="tip-line" wx:elif="{{processingLimits && !processingLimits.enabled}}">当前未启用云端制作频率限制。</view>
    <view class="tip-line" wx:else>制作频率限制以服务端提示为准。</view>
    <view class="tip-line">重新制作、换底等云端制作请求会计入次数，缓存命中也计入。直接保存已生成的照片不计入云端制作次数。</view>
    <view class="tip-line">达到云端制作上限时，已有照片仍可按账户权益保存；暂时无法使用云端美肤。</view>
  </view>

  <block wx:if="{{cloudEnabled && !loading && !error && goods.length > 0}}">
    <view class="section-title">选择解锁方式</view>

    <view class="card goods {{item.vip ? 'goods-vip' : ''}}" wx:for="{{goods}}" wx:key="goodsId">
      <view class="goods-head">
        <view class="goods-name">{{item.name}}</view>
        <view class="goods-badge" wx:if="{{item.vip}}">最划算</view>
      </view>
      <view class="goods-benefit">{{item.benefit}}</view>
      <view class="goods-foot">
        <view class="goods-price"><text class="price-symbol">¥</text>{{item.priceText}}</view>
        <button
          class="btn primary buy-btn"
          size="mini"
          disabled="{{paying}}"
          bindtap="onBuy"
          data-index="{{index}}"
        >立即购买</button>
      </view>
    </view>

    <view class="card tip-card">
      <view class="tip-title">购买须知</view>
      <view class="tip-line">· 高清无水印：去掉预览图上的「登科喵证件照」水印，可直接用于报名打印。</view>
      <view class="tip-line">· 会员有效期内不限保存次数；张数包按导出次数消耗。制作免费，但云端制作受上述频率限制。</view>
      <view class="tip-line">· 支付由微信虚拟支付完成，订单可在下方「我的订单」中查询。</view>
    </view>
  </block>

  <button class="btn ghost back" bindtap="onGoOrders">我的订单</button>
  <button class="btn ghost back" bindtap="onGoHome">返回首页</button>

  </block>
</view>
