/* 购买页：权益概览 + 商品卡 + 购买须知 + 云端规则
 * 字号/按钮/卡片均来自 app.wxss 全局规范 */

/* ---------- 权益概览 ---------- */

.ent-card {
  padding: 24rpx 28rpx;
}

.ent-line {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.ent-left {
  font-size: 28rpx;
  color: var(--c-text-2);
}

.ent-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--c-blue);
  margin: 0 4rpx;
}

.ent-vip {
  font-size: 28rpx;
  font-weight: 600;
  color: #b8860b;
}

.ent-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--c-text-3);
}

/* ---------- 商品卡 ---------- */

/* 最划算的一档：主蓝描边 + 浅蓝底，不加多余装饰 */
.goods-best {
  border: 2rpx solid var(--c-blue);
  background: var(--c-blue-tint);
}

.goods-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.goods-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--c-text);
}

.goods-benefit {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--c-text-2);
}

.goods-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.goods-price {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--c-blue);
}

.price-symbol {
  font-size: 24rpx;
  margin-right: 2rpx;
}

/* ---------- 文案块 ---------- */

.card-title + .note,
.soft-block .note + .note {
  margin-top: 8rpx;
}

/* 折叠入口：贴在购买须知下方 */
.rule-fold {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--c-line);
  font-size: 24rpx;
  color: var(--c-text-2);
}

.rule-fold .fold {
  padding: 0;
}

.rule-fold + .soft-block {
  margin-top: 12rpx;
}

/* 底部两个次要操作并排一行，省一屏高度（沿用 .btn 默认 88rpx 规格） */
.foot-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.foot-actions .btn {
  flex: 1;
  margin: 0;
}
