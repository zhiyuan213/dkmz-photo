/* 合规文本页公共样式（隐私政策 / 用户协议 / 关于与开源声明 @import 引用）
 * 字号与配色统一到 app.wxss 全局规范 */

.doc {
  padding: 32rpx 32rpx 64rpx;
}

.doc-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  color: var(--c-text);
  margin-bottom: 8rpx;
}

.doc-meta {
  font-size: 24rpx;
  color: var(--c-text-3);
  margin-bottom: 24rpx;
}

.doc-h {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--c-text);
  margin: 32rpx 0 12rpx;
}

.doc-p,
.doc-li {
  font-size: 28rpx;
  line-height: 1.75;
  color: #3a4150;
  margin-bottom: 12rpx;
}

.doc-strong {
  font-weight: 600;
  color: var(--c-text);
}

.doc-link {
  color: var(--c-blue);
}

.doc-links {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 36rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--c-line);
}

.doc-links .doc-link {
  font-size: 28rpx;
  padding: 8rpx 0;
  margin-right: 8rpx;
}

.doc-sep {
  color: #c6ccd8;
  margin: 0 14rpx;
  font-size: 24rpx;
}

.doc-note {
  margin-top: 28rpx;
  padding: 20rpx 22rpx;
  background: var(--c-blue-tint);
  border: 1rpx solid var(--c-blue-line);
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--c-text-2);
}
